    {
      "parameters": {
        "modelId": {
          "__rl": true,
          "mode": "list",
          "value": "models/gemini-3-flash-preview"
        },
        "messages": {
          "values": [
            {
              "content": "=你是設備維運系統的資料整理助手。請將以下操作員的簡短交接文字，整理成結構化JSON格式，欄位為：異常事項、待辦事項、風險提醒、機台狀態。\n\n原始輸入：{{ $json.body.raw_input }}\n機台：{{ $json.body.machine_id }}\n班別：{{ $json.body.shift_type }}\n\n規則：\n1. 如果原始輸入沒有提到某個欄位的內容，該欄位填「無」，不要編造內容\n2. 只回傳純JSON格式，不要加任何說明文字或markdown符號\n3. 格式範例：{\"異常事項\":\"無\",\"待辦事項\":\"無\",\"風險提醒\":\"無\",\"機台狀態\":\"正常運作\"}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        -272,
        112
      ],
      "id": "3cc54b83-6053-45e0-b141-073a101de616",
      "name": "Message a model",
      "credentials": {
        "googlePalmApi": {
          "id": "fyVKm40wrlSbTGSt",
          "name": "Google Gemini(PaLM) Api account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const rawText = item.json.content.parts[0].text;\n  let parsed;\n  try {\n    // 移除可能的markdown符號後解析\n    const cleaned = rawText.replace(/```json|```/g, '').trim();\n    parsed = JSON.parse(cleaned);\n  } catch (e) {\n    parsed = { \"異常事項\": \"無\", \"待辦事項\": \"無\", \"風險提醒\": \"無\", \"機台狀態\": \"解析失敗\" };\n  }\n\n  const fields = [\"異常事項\", \"待辦事項\", \"風險提醒\", \"機台狀態\"];\n  let filledCount = 0;\n  for (const f of fields) {\n    if (parsed[f] && parsed[f] !== \"無\") filledCount++;\n  }\n  // 機台狀態一定要有內容才算完整，其他三項允許填「無」\n  const hasStatus = parsed[\"機台狀態\"] && parsed[\"機台狀態\"] !== \"無\" && parsed[\"機台狀態\"] !== \"解析失敗\";\n  const completenessScore = hasStatus ? Math.min(1, 0.4 + filledCount * 0.2) : 0.2;\n\n  results.push({\n    json: {\n      structured_json: parsed,\n      completeness_score: completenessScore.toFixed(2),\n      flagged_incomplete: completenessScore < 0.6\n    }\n  });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -16,
        16
      ],
      "id": "e90d041c-ea7b-4478-8df6-cbfee8bdd3a8",
