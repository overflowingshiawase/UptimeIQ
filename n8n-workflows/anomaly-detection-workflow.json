    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst results = [];\n\nfor (const item of items) {\n  const data = item.json;\n  const daysSincePM = data.days_since_last_pm || 0;\n  const historicalAvg = 30; // 假設平均保養週期30天，可依實際調整\n  const faultWeight = data.alert_type === '滴油異常' ? 0.3 : 0.2;\n\n  const riskScore = (0.7 * (daysSincePM / historicalAvg)) + faultWeight;\n\n  results.push({\n    json: {\n      ...data,\n      calculated_risk_score: Math.min(riskScore, 1).toFixed(2)\n    }\n  });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        80,
        0
      ],
      "id": "ff581d83-c5b2-4b30-bc3a-7405c8ad4491",
